{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start local server",
            "type": "shell",
            "command": "python -m http.server 8080",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "http-server",
                "pattern": { "regexp": "^__never_matches__$" },
                "background": {
                    "activeAtBeginning": true,
                    "beginsPattern": "Serving HTTP",
                    "endsPattern": "Serving HTTP"
                }
            }
        }
    ]
}
